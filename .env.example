# ============================================================
# AMUCS Nexus - environment variable template (documentation)
# ============================================================
# Copy this file to `.env` and fill in YOUR OWN values.
# NEVER commit a real `.env` file; keep it out of Git.
# `.env.example` documents which variables exist. It is NOT
# a credentials file and contains no real keys.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Example format:
#   postgresql+psycopg://user:password@localhost:5432/amucs_nexus
# Leave empty to use SQLite (development default).
DATABASE_URL=

# --- LLM provider (YouRobo chat assistant) ---
# Two free-tier providers are supported via LLM_PROVIDER:
#   "gemini" (default): LLM_API_KEY or GEMINI_API_KEY from
#     https://aistudio.google.com/apikey  (model: LLM_MODEL)
#   "groq": GROQ_API_KEY from https://console.groq.com (model: GROQ_MODEL)
#     Fast + high quality (openai/gpt-oss-120b, free tier).
# Without any key the chatbot still answers, but in safe offline "extractive"
# mode (it can only re-use indexed text, so it cannot hallucinate URLs/dates).
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Student uploads and anonymous opt-in notice notifications ---
UPLOAD_EXPIRY_HOURS=24
# Generate with:
# python -c "import base64; from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization; v=Vapid(); v.generate_keys(); open('vapid_private.pem','w').write(v.private_key.private_bytes(serialization.Encoding.PEM,serialization.PrivateFormat.PKCS8,serialization.NoEncryption()).decode()); p=v.public_key.public_bytes(serialization.Encoding.X962,serialization.PublicFormat.UncompressedPoint); print(base64.urlsafe_b64encode(p).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
# Recommended local option: keep the PEM in an ignored *.pem file and set its path.
VAPID_PRIVATE_KEY_FILE=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:amu-cs-nexus@example.com
NOTICE_SYNC_ENABLED=false
NOTICE_SYNC_INTERVAL_SECONDS=900

# --- Cache (reserved; not used yet) ---
REDIS_URL=

# --- Frontend ---
# Base URL of the backend API used by the frontend HTTP client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend CORS ---
# Comma-separated list of allowed browser origins for cross-origin API calls.
CORS_ORIGINS=http://localhost:3000