# ============================================================
# AMUCS Nexus .gitignore
# ============================================================

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.whl
*.egg

# --- Node / frontend ---
node_modules/
.next/
# `out/` is intentionally NOT ignored: frontend/out is the static export that
# FastAPI serves in production (Render has no Node, so it cannot build it).
# Re-adding `out/` here would untrack the deployed frontend.
dist/
build/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.turbo/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Database / local data ---
*.db
*.sqlite3
pgdata/

# --- Misc / local overrides ---
.env.local
.env.development.local
.env.test.local


# TypeScript incremental build info
*.tsbuildinfo


# Windows shortcuts / local scratch
*.lnk
# Local server logs
backend/server.log
backend/prod.log
backend/dev2.log
frontend/dev.log
